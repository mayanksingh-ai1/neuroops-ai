# Phase 2: Copy this file to .env only if .env does not already exist.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Docker Compose uses this database connection from the backend container:
# DATABASE_URL=postgresql+psycopg://neuroops:local_dev_only_change_me@db:5432/neuroops
# Local PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://neuroops:change_me@127.0.0.1:5432/neuroops
# Create a different random 32+ character secret for each environment.
# IMPORT_API_KEY=replace_with_a_random_32_character_minimum_secret

# Phase 3: backend only. Paid calls occur only on explicit classification requests.
OPENAI_API_KEY=
# Choose an available OpenAI model supporting strict JSON schema.
LLM_MODEL=
# Optional JSON; allowed safety terms must come from intelligence.py VOCABULARY.
# AI_RULES_JSON={"categories":["Delivery Delay","Refund Issue","Damaged Product","Wrong Item","Product Quality","Customer Support","Other"],"high_priority_terms":["unsafe","dangerous","injury","fire"],"negative_priority":"medium","default_priority":"low"}

# Phase 4: workspace capability keys; each value must be distinct and 32+ chars.
# Generate random keys; do not use the placeholder below as a real credential.
# KB_WORKSPACE_KEYS_JSON={"company":"replace_with_a_random_workspace_key_of_32_plus_characters"}
# Only this workspace may read the installation's existing global complaint aggregates.
KB_ANALYTICS_WORKSPACE=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
# For ollama: EMBEDDING_PROVIDER=ollama and EMBEDDING_MODEL=<installed embedding model>
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
# Uses LLM_MODEL when omitted. OpenAI remains the answer provider.
# RAG_LLM_MODEL=
KB_UPLOAD_BYTES=5242880
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_WORKSPACE_CHUNKS=1000
KB_WORKSPACE_DOCUMENTS=100
KB_MIN_SIMILARITY=0.3
KB_REQUESTS_PER_MINUTE=10

# Phase 5: reuses the existing OpenAI account; provider calls may incur charges.
# Empty AGENT_LLM_MODEL falls back to LLM_MODEL; use a structured-output capable model.
AGENT_LLM_MODEL=
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_SECONDS=90
AGENT_RETRIES=1

# Phase 6: optional judge uses the existing backend OpenAI credential.
EVAL_JUDGE_PROVIDER=openai
# Empty uses LLM_MODEL. Choose a strict JSON-schema-capable model.
EVAL_JUDGE_MODEL=
# Separate random reviewer secrets, scoped to existing workspace names.
# EVAL_REVIEWER_KEYS_JSON={"company":{"reviewer-alice":"replace-with-a-distinct-random-secret-at-least-32-characters"}}
EVAL_REVIEWER_KEYS_JSON={}

# Phase 7: Production readiness, security, and access control.
# In development, AUTH_REQUIRED=false allows open access.
# In production, set APP_ENV=production or AUTH_REQUIRED=true.
AUTH_REQUIRED=false
# JSON map of user IDs to role, workspace, and token SHA-256 hash.
# Token must be 32-512 chars; hash is its lowercase 64-char hex SHA-256 digest.
# Roles: viewer (read-only), operator (run agent/eval/classify/upload), reviewer (review evaluations), admin (all actions + metrics).
# AUTH_USERS_JSON={"alice":{"token_sha256":"<64_hex_sha256>","role":"admin","workspace":"company"}}
AUTH_USERS_JSON={}
# Allowed CORS origins as a strict JSON array of strings (no wildcards).
CORS_ORIGINS_JSON=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
