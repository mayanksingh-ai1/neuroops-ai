# NeuroOps AI - Docker Compose environment configuration example
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env

# Security: Mandatory secret for complaint imports (minimum 32 characters).
IMPORT_API_KEY=replace_with_a_random_32_character_minimum_secret

# Optional OpenAI integration for classification, RAG, agent, and evaluation judge:
OPENAI_API_KEY=
LLM_MODEL=

# Phase 4: Knowledge base workspace capability keys:
# KB_WORKSPACE_KEYS_JSON={"company":"replace_with_a_random_workspace_key_of_32_plus_characters"}
KB_ANALYTICS_WORKSPACE=

# Phase 5: Agent settings
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_SECONDS=90
AGENT_RETRIES=1

# Phase 6: Evaluation reviewer capability keys
# EVAL_REVIEWER_KEYS_JSON={"company":{"reviewer-alice":"replace_with_a_random_reviewer_key_of_32_plus_chars"}}
EVAL_REVIEWER_KEYS_JSON={}

# Phase 7: Access Control & Operations
# Set to 'production' or AUTH_REQUIRED=true to enforce token authentication and RBAC.
APP_ENV=production
AUTH_REQUIRED=true
# AUTH_USERS_JSON={"admin_user":{"token_sha256":"<64_hex_sha256>","role":"admin","workspace":"company"}}
AUTH_USERS_JSON={}
# Required Compose database settings. URL-encode the password in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_unique_random_database_password
DATABASE_URL=postgresql+psycopg://neuroops:replace_with_a_unique_random_database_password@db:5432/neuroops
CORS_ORIGINS_JSON=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
