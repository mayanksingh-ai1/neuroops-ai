# Phase 2: Copy this file to .env only if .env does not already exist.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Docker Compose uses this database connection from the backend container:
# DATABASE_URL=postgresql+psycopg://neuroops:local_dev_only_change_me@db:5432/neuroops
# Local PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://neuroops:change_me@127.0.0.1:5432/neuroops
# Create a different random 32+ character secret for each environment.
# IMPORT_API_KEY=replace_with_a_random_32_character_minimum_secret

# Phase 3: backend only. Paid calls occur only on explicit classification requests.
OPENAI_API_KEY=
# Choose an available OpenAI model supporting strict JSON schema.
LLM_MODEL=
# Optional JSON; allowed safety terms must come from intelligence.py VOCABULARY.
# AI_RULES_JSON={"categories":["Delivery Delay","Refund Issue","Damaged Product","Wrong Item","Product Quality","Customer Support","Other"],"high_priority_terms":["unsafe","dangerous","injury","fire"],"negative_priority":"medium","default_priority":"low"}
